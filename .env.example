# === Libreria contenuti ===
# json = file locale content/posts.json | airtable = calendario su Airtable
CONTENT_STORE=json
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Posts
# Per testare Airtable SENZA account: AIRTABLE_FAKE=1 (usa un file finto in-memory)
AIRTABLE_FAKE=
AIRTABLE_FAKE_FILE=content/airtable_fake.json

# === Generale ===
# File di log dell'agente (usato soprattutto in modalità daemon --loop)
AGENT_LOG=agent.log

# === Approvazione (Fase 1) ===
# console = conferma da terminale | telegram = anteprima + pulsanti sul telefono
APPROVAL_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_TIMEOUT=3600

# === Uploader media (per rendere PUBBLICI i file locali) ===
# local | s3 | github | (vuoto = i media devono già essere URL pubblici)
MEDIA_UPLOADER=
# -- opzione "local": copia in una cartella servita dal tuo web server --
MEDIA_LOCAL_DIR=/var/www/media
MEDIA_BASE_URL=https://tuosito.com/media
# -- opzione "s3" --
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=eu-south-1
# -- opzione "github": copia nel repo (deve girare dentro il checkout),
#    fa commit+push e restituisce l'URL raw.githubusercontent.com.
#    Pensata per la Routine cloud: il repo pubblico fa da hosting immagini.
MEDIA_GITHUB_REPO=owner/nome-repo
MEDIA_GITHUB_BRANCH=main
MEDIA_GITHUB_DIR=public/carousels
# Token opzionale (PAT fine-grained, permesso "Contents: Read and write" solo
# su questo repo) per push autenticato. Necessario nelle Routine cloud, dove
# le credenziali git della sessione non hanno accesso in scrittura al repo.
# Se assente, si usa il remote/credenziali già configurati (uso locale).
MEDIA_GITHUB_PUSH_TOKEN=

# === Produzione contenuti (python main.py produce) ===
# Script (agente 1) — API Anthropic
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5
# Voce (agente 2) — ElevenLabs (VOICE_ID dalla sezione "Voices" della dashboard)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Video (agente 3) — Sync Labs (lip-sync). Serve anche MEDIA_UPLOADER (sopra):
# Sync Labs legge i file da URL pubblici. E ffmpeg installato sul sistema.
SYNC_API_KEY=
SYNC_MODEL=lipsync-2-pro
# Footage locale della persona che parla in camera (video "base" per il lip-sync)
BASE_VIDEO_PATH=
# Piattaforme di destinazione delle bozze prodotte
PRODUCE_PLATFORMS=telegram,instagram,facebook
# Hashtag/CTA aggiunti in coda alla didascalia generata (opzionale)
CAPTION_SUFFIX=

# === Caroselli (python main.py produce-carousel) ===
# Copy (agente) — riusa ANTHROPIC_API_KEY sopra
CAROUSEL_MODEL=claude-sonnet-5
# Piattaforme di destinazione dei caroselli prodotti
CAROUSEL_PLATFORMS=instagram,facebook

# -- Immagine di copertina (agents/cover_image.py) --
# auto = prova Stability, poi Pexels, poi nessuna immagine (fallback tipografico)
# stability | pexels | none = forza un provider specifico
COVER_IMAGE_PROVIDER=auto
# Generazione AI dell'immagine, nello stile scelto dal copy agent per il topic
STABILITY_API_KEY=
# Fallback foto stock royalty-free se manca/fallisce la generazione AI
PEXELS_API_KEY=

# === Modalità simulazione ===
# DRY_RUN=1 -> non chiama nessuna API: simula la pubblicazione (nessun account).
# Utile per sviluppare/testare tutta la pipeline. Lascia vuoto in produzione.
DRY_RUN=

# === Meta (Facebook + Instagram) ===
# Versione Graph API (bumpala se Meta rilascia una versione più recente)
GRAPH_API_VERSION=v21.0
# ID della Pagina Facebook
FB_PAGE_ID=
# Token long-lived della Pagina (NON il token utente). Vedi docs/SETUP_META.md
FB_PAGE_ACCESS_TOKEN=
# ID dell'account Instagram Business collegato alla Pagina
IG_USER_ID=

# === X (Twitter) ===
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === YouTube ===
# File JSON con il token OAuth autorizzato sul canale
YOUTUBE_TOKEN_FILE=
YOUTUBE_PRIVACY_STATUS=private

# === TikTok ===
TIKTOK_ACCESS_TOKEN=
# Finché l'app non supera l'audit: solo SELF_ONLY (privato)
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# === Telegram (canale come piattaforma di pubblicazione) ===
# Riusa TELEGRAM_BOT_TOKEN (sopra); il bot deve essere admin del canale
TELEGRAM_CHANNEL_ID=
